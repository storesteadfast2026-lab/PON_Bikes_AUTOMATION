DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.16.50
DJANGO_TIME_ZONE=Australia/Adelaide
PON_WEB_PORT=8001
COMPOSE_PROJECT_NAME=pon_bike_automation_09161055

# Native Windows execution can use the S: path directly.
PON_CONTAINER_ROOT=S:\FORMS\CUSTOMER\PON - Pon.Bike\2026 Containers
PON_PRODUCT_CATALOG_PATH=C:\Docker-Projects\Freight-Calc-v1.6\uploaded_data\products_pon_pbp_auto.xls
PON_PRODUCT_MOVES_PATH=T:\STEADFAST\EXCEL FILES\PRODUCT_MOVES.CSV
PON_UPSTOCKSERIAL_PATH=T:\Import\UPStockSerial.csv

# Docker database settings.
POSTGRES_DB=pon_bikes
POSTGRES_USER=pon_bikes
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Docker Desktop host folders. Prefer UNC paths for permanent server deployment.
PON_HOST_PATH=S:/FORMS/CUSTOMER/PON - Pon.Bike/2026 Containers
PON_PRODUCT_HOST_DIR=C:/Docker-Projects/Freight-Calc-v1.6/uploaded_data
PON_MOVES_HOST_DIR=C:/Docker-Projects/PON_Bike_Data/translogic
PON_IMPORT_HOST_DIR=C:/Docker-Projects/PON_Bike_Data/import
PON_REPORT_HOST_DIR=C:/Docker-Projects/PON_Bike_Data/reports

# Optional direct Translogic mounts. 01_PREPARE_INSTALL probes the real configured
# Windows paths and enables these only when Docker can mount them safely.
PON_TRANSLOGIC_IMPORT_DIRECT_ENABLED=0
PON_TRANSLOGIC_IMPORT_HOST_DIR=./sample_translogic_import_direct
PON_PRODUCT_MOVES_DIRECT_ENABLED=0
PON_PRODUCT_MOVES_DIRECT_HOST_DIR=./sample_translogic_moves_direct

# First login created by the Docker entrypoint when all three values are present.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.local
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password

# Paths shown to the operator on the guided workflow screen.
PON_PRODUCT_CATALOG_SOURCE_DISPLAY=C:\Docker-Projects\Freight-Calc-v1.6\uploaded_data\products_pon_pbp_auto.xls
PON_PRODUCT_MOVES_SOURCE_DISPLAY=T:\STEADFAST\EXCEL FILES\PRODUCT_MOVES.CSV
PON_PRODUCT_MOVES_WORKING_DISPLAY=C:\Docker-Projects\PON_Bike_Data\translogic\PRODUCT_MOVES.CSV
PON_UPSTOCK_WORKING_DISPLAY=C:\Docker-Projects\PON_Bike_Data\import\UPStockSerial.csv
PON_UPSTOCK_FINAL_DISPLAY=T:\Import\UPStockSerial.csv
PON_CLIENT_REPORT_WORKING_DISPLAY=C:\Docker-Projects\PON_Bike_Data\reports
# Leave blank until the final archive/customer location is agreed.
PON_CLIENT_REPORT_FINAL_DISPLAY=
